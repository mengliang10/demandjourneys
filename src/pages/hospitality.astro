---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/interior.css';
const situations=[
{title:'Independent hotels and boutique groups',question:'Can the property improve direct booking economics without sacrificing profitable demand?',work:'Distribution review, booking-funnel diagnostic, metasearch decision framework and channel governance.'},
{title:'Regional hotel and residence portfolios',question:'Are acquisition, loyalty, website and distribution teams working from the same commercial measures?',work:'Cross-property operating model, agency oversight, customer-journey mapping and measurement design.'},
{title:'Travel marketplaces and experience operators',question:'Where do acquisition costs, platform friction and repeat behaviour create avoidable leakage?',work:'Performance media review, conversion experimentation and lifecycle/CRM prioritisation.'},
{title:'Hospitality owners and asset managers',question:'Which digital initiatives have a defensible business case, an accountable owner and realistic implementation dependencies?',work:'Decision workshops, platform evaluation, vendor governance and executive reporting.'}
];
---
<SiteLayout title="Hospitality & Travel Advisory | Demand Journeys" description="Independent hospitality and travel advisory for booking journeys, distribution economics, performance marketing, guest data and commercial systems." current="services" bodyClass="interior hospitality-focus">
<div class="container hospitality-landing">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Hospitality &amp; Travel</span></nav>
<header class="focus-hero"><span class="eyebrow">Industry focus / Hospitality & travel</span><h1>Demand is only valuable when the whole journey works.</h1><p>Connecting discovery, booking, distribution, loyalty, customer platforms and commercial governance for hospitality and travel operators in Singapore and APAC.</p><div class="focus-actions"><a class="button" href="/#enquiry">Discuss a challenge ↗</a><a href="/selected-work/">Review documented experience →</a></div></header>
<section class="focus-grid" aria-label="Hospitality client challenges">{situations.map((s,i)=><article><span class="eyebrow">{String(i+1).padStart(2,'0')} / Client situation</span><h2>{s.title}</h2><p><strong>The question:</strong> {s.question}</p><p><strong>Potential scope:</strong> {s.work}</p></article>)}</section>
<section class="focus-method"><span class="eyebrow">The commercial system</span><h2>One journey, several accountable decisions.</h2><ol><li><strong>Discover:</strong> Search visibility, AI discovery, brand and intent.</li><li><strong>Acquire:</strong> Media efficiency and the economics of demand.</li><li><strong>Convert:</strong> Booking path, price presentation and payment friction.</li><li><strong>Distribute:</strong> Direct, OTA and partner channel decisions.</li><li><strong>Retain:</strong> Guest data, loyalty, CRM and repeat demand.</li><li><strong>Govern:</strong> Attribution, reporting, vendors and cross-functional ownership.</li></ol><div class="focus-actions"><a href="/hospitality-presentations/commercial-system/">View the commercial-system presentation →</a><a href="/interactive-tools/">Explore interactive diagnostics →</a></div></section>
<aside class="focus-boundary">Professional operating examples are drawn from prior roles and research. They are not represented as engagements delivered by Demand Journeys unless explicitly labelled. Scope depends on client data and system access.</aside>
</div>
</SiteLayout>
<style>
.hospitality-landing{max-width:1180px;margin:auto;padding:30px clamp(20px,4vw,48px) 100px}.focus-hero{padding:60px 0 65px;max-width:910px}.focus-hero h1{font:500 clamp(2.65rem,5vw,4.8rem)/1.06 Outfit,sans-serif;letter-spacing:-.045em;margin:17px 0}.focus-hero>p{font-size:1.15rem;line-height:1.65;max-width:750px}.focus-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-top:28px}.focus-actions>a{font-weight:650;text-underline-offset:4px}.focus-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.focus-grid article{border:1px solid #d8e0d6;background:#fffefa;padding:clamp(24px,3vw,36px);border-radius:6px}.focus-grid h2{font:500 clamp(1.4rem,2.5vw,1.9rem)/1.2 Outfit,sans-serif;margin:18px 0}.focus-grid p{line-height:1.65}.focus-method{margin-top:50px;padding:clamp(25px,4vw,48px);background:#edf2ed;border-radius:6px}.focus-method h2{font:500 clamp(1.8rem,3vw,2.65rem) Outfit,sans-serif}.focus-method ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px 30px;padding:20px 0 20px 22px}.focus-method li{padding:6px;line-height:1.55}.focus-boundary{padding:25px 0;margin-top:30px;border-top:1px solid #cad5cb;color:#52675c;font-size:.9rem;line-height:1.6}@media(max-width:700px){.focus-grid,.focus-method ol{grid-template-columns:1fr}}
</style>