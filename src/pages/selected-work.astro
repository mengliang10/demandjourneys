---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/interior.css';
import '../styles/interactive-tools.css';
const examples=[
  {name:'Enterprise booking experience transformation',deck:'booking-transformation',type:'Implemented programme',context:'Frasers Hospitality · Project Meta',challenge:'Simplify a complex global digital booking experience and improve the underlying content and booking journey.',scope:'Conceived and business-cased the programme, secured Board approval and led implementation governance across the web and booking ecosystem.',evidence:['Approximate page-load reduction from 7.1 to 3.0 seconds','Booking journey simplified from approximately 10 steps to 5','Direct website room nights increased by 56% in the documented programme context'],boundary:'These are programme-associated operating outcomes, not isolated causal effects attributable to any single design change. Financial figures are intentionally omitted.'},
  {name:'Customer data platform strategy',deck:'customer-data-platform',type:'Planned and specified, not deployed',context:'Hospitality customer-platform planning',challenge:'Unify the business requirements for customer identity, lifecycle activation and guest-level measurement.',scope:'Developed CDP concept, architecture direction, roadmap, RFP, business case and implementation planning.',evidence:['Business and platform requirements translated into an implementation roadmap','Vendor evaluation and procurement planning completed'],boundary:'Full CDP approval and deployment were not completed before departure. No unified production guest profile is claimed.'},
  {name:'Regional distribution and media governance',deck:'distribution-governance',type:'Leadership and operating experience',context:'Hospitality and travel · APAC',challenge:'Coordinate direct commerce, marketplace distribution, agency investment and commercial reporting across markets.',scope:'Regional digital marketing, channel oversight, selected chain distribution contracting, forecasting and cross-functional governance.',evidence:['Direct involvement in chain agreements with major online travel agencies','Forecasting responsibilities spanning weekly through long-range planning'],boundary:'Property-level OTA execution was locally owned. Revenue management was shared commercial governance, not sole functional ownership.'}
];
---
<SiteLayout title="Selected Work & Evidence | Demand Journeys" description="Evidence-led examples of implemented transformation, planned customer-platform work and regional governance, with explicit delivery boundaries." current="selected-work" bodyClass="interior tools-page">
<div class="container evidence-page">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Selected work</span></nav>
<header class="evidence-heading"><span class="eyebrow">Selected experience / Evidence boundaries</span><h1>What has been delivered, governed and planned.</h1><p>These examples refer to professional roles and programmes, not necessarily clients of Demand Journeys. Specific outcomes are described only where supported by the professional evidence record.</p></header>
<div class="evidence-list">{examples.map((entry,i)=><article class="evidence-entry"><div class="evidence-number">{String(i+1).padStart(2,'0')} / {entry.type}</div><h2>{entry.name}</h2><p class="evidence-context">{entry.context}</p><div class="evidence-columns"><section><h3>Business problem</h3><p>{entry.challenge}</p><h3>Scope of involvement</h3><p>{entry.scope}</p></section><section><h3>Documented evidence</h3><ul>{entry.evidence.map(point=><li>{point}</li>)}</ul><h3>Limitations</h3><p>{entry.boundary}</p></section></div><div class="evidence-deck"><div class="evidence-deck-heading"><div><span class="eyebrow">Interactive case-study presentation</span><h3>Reveal.js deck · Placeholder edition</h3><p>Six slides covering context, involvement, supported evidence and materials awaiting approval.</p></div><a href={`/selected-work/decks/${entry.deck}/`} class="evidence-deck-link">Open full presentation ↗</a></div><iframe loading="lazy" title={`Reveal.js placeholder deck for ${entry.name}`} src={`/selected-work/decks/${entry.deck}/?preview=1`} class="evidence-deck-frame" allow="fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div></article>)}</div>
<aside class="evidence-note"><h2>How we assess evidence</h2><p>Implemented result, delivered scope, planned initiative and advisory work are different kinds of evidence. Demand Journeys does not attribute another organisation's work to itself or publish confidential client results without permission.</p><div><a href="/profile/">Professional profile →</a><a href="/hospitality-presentations/">Explore presentations →</a><a href="/#enquiry">Discuss an engagement →</a></div></aside>
</div>
</SiteLayout>
<style>
.evidence-page{max-width:1180px;margin:0 auto;padding:32px clamp(20px,4vw,55px) 100px}.evidence-heading{max-width:900px;margin:42px 0 52px}.evidence-heading h1{font:500 clamp(2.4rem,5vw,4.5rem)/1.08 Outfit,Arial,sans-serif;letter-spacing:-.04em;margin:14px 0 18px}.evidence-heading p{max-width:760px;line-height:1.7}.evidence-list{display:grid;gap:24px}.evidence-entry{background:#fffefa;border:1px solid #d7dfd6;border-radius:7px;padding:clamp(22px,4vw,45px)}.evidence-number{font-size:.79rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#60716a}.evidence-entry h2{font:500 clamp(1.7rem,3vw,2.5rem)/1.2 Outfit,sans-serif;margin:15px 0 9px}.evidence-context{color:#60716a;font-size:.9rem;margin-bottom:24px}.evidence-columns{display:grid;grid-template-columns:1fr 1fr;gap:clamp(25px,4vw,70px)}.evidence-columns h3{font-size:1rem;margin:25px 0 8px}.evidence-columns p,.evidence-columns li{font-size:.98rem;line-height:1.7}.evidence-columns ul{padding-left:22px}.evidence-note{padding:34px;margin-top:35px;background:#203e3a;color:#fffefa}.evidence-note h2{font:500 1.8rem Outfit,sans-serif;color:inherit}.evidence-note p{max-width:760px;line-height:1.65}.evidence-note a{display:inline-block;margin:12px 23px 0 0;color:#fffefa;text-underline-offset:3px}@media(max-width:700px){.evidence-columns{grid-template-columns:1fr;gap:0}}
</style>