  <a class="atlas-brand-wordmark" href="/hospitality-presentations/" aria-label="Demand Journeys presentation library"><img src="/identity/wordmark-white-456.webp" alt="Demand Journeys" width="160" height="24" /></a>
  <div id="atlas-app" set:html={markup} />
<script is:inline src="/hospitality-presentations/tri-market-blueprint/original.js"></script>
