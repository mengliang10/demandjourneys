---
import RelatedPresentations from '../components/RelatedPresentations.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/interior.css';
import '../styles/refinement.css';
import ServiceHero from '../components/ServiceHero.astro';
const hero = {
  "eyebrow": "AEO/GEO · AI search visibility",
  "headline": "When customers ask AI, does your expertise appear?",
  "lead": "Fractional GEO, AEO and SEO leadership for businesses that need to be found, understood and considered across search and AI answers.",
  "approach": "A diagnostic first. A bounded pilot next. One accountable lead across SEO, content, technology and measurement.",
  "enquiryLabel": "Discuss your visibility challenge",
  "deckLabel": "Open the 28-slide programme",
  "note": "Rankings, citations and revenue are outcomes to measure, not guarantees. No client lift is claimed.",
  "enquiryHref": "/#enquiry",
  "deckHref": "/hospitality-presentations/geo-work/",
  "facts": [
    [
      "Disciplines",
      "SEO · AEO · GEO"
    ],
    [
      "Evidence",
      "Two anonymised financial-services diagnostics"
    ],
    [
      "First sprint",
      "90 days, four decision gates"
    ],
    [
      "Engagements",
      "Diagnostic · Pilot · Fractional lead"
    ],
    [
      "Markets",
      "Singapore · APAC and global engagements"
    ]
  ]
};

const title = 'AEO/GEO — AI Search Visibility | Demand Journeys';
const description = 'Fractional GEO, AEO and SEO leadership from Demand Journeys: diagnose how your business appears in AI answers, fix the evidence, and measure citations and qualified actions.';

---

<SiteLayout title={title} description={description} current="ai-search" ogImage="/presentation-previews/geo-work.jpg">
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'AI search optimisation (GEO, AEO and SEO)',
    serviceType: 'Generative engine optimisation',
    description,
    url: 'https://www.demandjourneys.com/ai-search/',
    areaServed: ['Singapore', 'Asia Pacific'],
    provider: {
      '@type': 'ProfessionalService',
      name: 'Demand Journeys',
      url: 'https://www.demandjourneys.com/',
      email: 'ml@demandjourneys.com',
      founder: { '@type': 'Person', name: 'Meng Liang Tan', sameAs: 'https://www.linkedin.com/in/mengliang/' }
    }
  })} />
  </Fragment>

   <nav class="breadcrumb container" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">AEO/GEO</span></nav>

   <ServiceHero {...hero} />

   <RelatedPresentations ids={['geo-work']} />
</SiteLayout>
