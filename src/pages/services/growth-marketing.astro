---
import ServicePage from '../../components/ServicePage.astro';
import ServiceHero from '../../components/ServiceHero.astro';

const title = "Growth Marketing";
const hero = {
  "eyebrow": "Growth Marketing · Acquisition & retention",
  "headline": "Where are you losing customers you’ve already paid to reach?",
  "lead": "Growth marketing leadership for teams deciding how much to spend on acquisition, where to improve conversion and how to bring customers back.",
  "approach": "Start with one customer journey. Trace the cost of reaching buyers, find where they drop out and test one change against the margin it could earn.",
  "enquiryLabel": "Discuss your growth challenge",
  "deckLabel": "Open the 10-slide commercial strategy deck",
  "deckHref": "/hospitality-presentations/commercial-system/",
  "facts": [
    [
      "Disciplines",
      "Acquisition · Conversion · Retention"
    ],
    [
      "Evidence",
      "Channel costs, purchase funnels and repeat purchase data"
    ],
    [
      "First sprint",
      "Map one journey and prioritise one experiment"
    ],
    [
      "Engagements",
      "Workshop · Audit · Fractional leadership"
    ],
    [
      "Markets",
      "Singapore · Asia Pacific"
    ]
  ],
  "note": "Agree the success measure before the test, including how you’ll account for channel costs."
};
---
<ServicePage title={title} current="growth-marketing" description="Growth marketing advisory connecting acquisition, conversion, retention, experimentation and commercial performance.">
  <ServiceHero slot="introduction" {...hero} enquiryHref={`/?service=${encodeURIComponent(title)}#enquiry`} />
</ServicePage>
