---
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/interior.css';
const offers=[
{title:'AI Search & LLM Citation Audit',buyer:'Marketing, brand and digital leaders',problem:'When your organisation is missing or misrepresented in AI-generated answers.',scope:['Crawler access and indexability','Entity and structured-data integrity','Priority-query and competitor citation checks','Evidence-backed remediation roadmap'],handoff:'Audit, query benchmark and prioritised action plan',href:'/ai-search/'},
{title:'Hotel Direct Booking & Distribution Review',buyer:'Hotel owners, GMs, commercial and distribution leaders',problem:'When direct acquisition economics, OTA dependence and rate governance are unclear.',scope:['Direct booking journey review','OTA distribution terms and parity controls','Metasearch and brand-search economics','Channel governance and direct-value strategy'],handoff:'Distribution diagnostic and decision roadmap',href:'/hospitality/'},
{title:'Performance Marketing & Agency Governance',buyer:'CMOs, CFOs and regional growth leaders',problem:'When the team cannot distinguish incremental demand from attributed activity.',scope:['Search and media account structure','Brand bidding and attribution scrutiny','Agency scope, fees and platform governance','Measurement and experiment priorities'],handoff:'Independent governance assessment and improvement backlog',href:'/services/growth-marketing/'},
{title:'Executive Digital Growth Workshop',buyer:'Executive and cross-functional leadership teams',problem:'When teams disagree about the demand problem, the customer journey or success measures.',scope:['Leadership interviews and decision framing','Commercial journey mapping','Metric and ownership alignment','Prioritised workshop decisions'],handoff:'Facilitated decision session and agreed next steps',href:'/hospitality-presentations/commercial-system/'},
{title:'Booking Funnel & Conversion Optimisation',buyer:'Ecommerce, digital product and hotel distribution leads',problem:'When traffic acquisition exceeds the ability of the website or booking engine to convert.',scope:['Mobile and performance friction review','Step-level funnel diagnosis','Checkout and payment usability','Test hypotheses and implementation backlog'],handoff:'Conversion audit and test-ready roadmap',href:'/interactive-tools/#booking-funnel'},
{title:'MarTech & CRM Platform Evaluation',buyer:'Marketing, IT, procurement and analytics leadership',problem:'When a platform selection or migration needs defensible requirements and buyer-side governance.',scope:['Use cases and data readiness','Architecture and integration requirements','Vendor-neutral scoring and RFP support','Implementation ownership and roadmap'],handoff:'Requirements, scoring rubric and vendor decision brief',href:'/services/platforms-analytics/'},
{title:'Digital Voucher & Ancillary GTM Strategy',buyer:'Hotel F&B, leisure, attractions and commercial teams',problem:'When prepaid offers, gifting or ancillary experiences need cohesive marketing and operations.',scope:['Offer and channel architecture','Issuance and redemption journey','Operational and data integration needs','Marketing launch and governance plan'],handoff:'GTM and operating blueprint',href:'/hospitality/'}
];
---
<SiteLayout title="Advisory Engagements | Demand Journeys" description="Scoped, evidence-led advisory engagements across AI search, distribution, performance marketing, conversion, MarTech and hospitality commercial strategy." current="services" bodyClass="interior service-page">
<div class="container engagements">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span><span aria-current="page">Advisory engagements</span></nav>
<header class="engagement-intro"><span class="eyebrow">Demand Journeys / Consulting services</span><h1>Specific business problems. Defined outputs.</h1><p>Engagements begin with a diagnostic, a focused workshop or fractional leadership scope. Deliverables and decision ownership are agreed before work starts. No fixed prices, promised returns or assumed client outcomes are published.</p></header>
<div class="engagement-grid">{offers.map((offer,i)=><article class="engagement-card"><span class="eyebrow">{String(i+1).padStart(2,'0')} / Advisory</span><h2>{offer.title}</h2><p class="buyer">{offer.buyer}</p><p>{offer.problem}</p><h3>Typical workstreams</h3><ul>{offer.scope.map(s=><li>{s}</li>)}</ul><p class="handoff"><strong>Output:</strong> {offer.handoff}</p><a href={offer.href}>Explore the approach →</a></article>)}</div>
<aside class="engagement-cta"><h2>Choose the question, then the work.</h2><p>Relevant examples are documented on the selected-work page. Advisory findings depend on access to the client's real systems and data.</p><a href="/selected-work/">Review experience and evidence →</a><a href="/#enquiry">Enquire →</a></aside>
</div>
</SiteLayout>
<style>
.engagements{max-width:1220px;padding:30px clamp(18px,4vw,45px) 100px;margin:auto}.engagement-intro{padding:35px 0 50px;max-width:850px}.engagement-intro h1{font:500 clamp(2.4rem,5vw,4.3rem)/1.09 Outfit,Arial,sans-serif;letter-spacing:-.04em;margin:15px 0}.engagement-intro p{font-size:1.05rem;line-height:1.7;max-width:710px}.engagement-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.engagement-card{padding:clamp(24px,3vw,34px);border:1px solid #d6ded4;background:#fffefa;border-radius:6px;display:flex;flex-direction:column}.engagement-card h2{font:500 clamp(1.4rem,2.3vw,1.85rem)/1.25 Outfit,Arial,sans-serif;margin:15px 0}.engagement-card .buyer{font-size:.83rem;font-weight:650;color:#50665a}.engagement-card p,.engagement-card li{line-height:1.65}.engagement-card h3{font-size:.96rem;margin:14px 0 5px}.engagement-card ul{padding-left:20px;margin:5px 0 20px}.engagement-card .handoff{margin-top:auto;border-top:1px solid #e1e6de;padding-top:15px}.engagement-card>a{font-weight:700;text-underline-offset:3px}.engagement-cta{background:#203e3a;color:#fffefa;padding:34px;margin-top:35px}.engagement-cta h2{font:500 1.9rem Outfit,sans-serif;color:inherit}.engagement-cta p{line-height:1.6}.engagement-cta a{color:inherit;display:inline-block;margin:15px 25px 0 0}@media(max-width:700px){.engagement-grid{grid-template-columns:1fr}}
</style>