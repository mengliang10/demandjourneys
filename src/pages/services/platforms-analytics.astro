---
import ServicePage from '../../components/ServicePage.astro';
import ServiceHero from '../../components/ServiceHero.astro';

const title = "Platforms & Analytics";
const hero = {
  "eyebrow": "Platforms & Analytics · Marketing technology & measurement",
  "headline": "Can your team trust the numbers behind its next decision?",
  "lead": "Marketing technology and analytics advisory for teams connecting customer data, choosing platforms and building reports they can use to make decisions.",
  "approach": "Start with one decision your team makes regularly. Trace its data back to the source, agree how to calculate the metric and give someone ownership of the report.",
  "enquiryLabel": "Discuss your data challenge",
  "deckLabel": "Open the 12-slide portfolio",
  "deckHref": "/hospitality-presentations/personal-portfolio/",
  "facts": [
    [
      "Disciplines",
      "CRM · Marketing technology · Analytics"
    ],
    [
      "Evidence",
      "Source data, KPI definitions and reporting workflows"
    ],
    [
      "First sprint",
      "Map one use case and specify a dashboard"
    ],
    [
      "Engagements",
      "Workshop · Audit · Fractional leadership"
    ],
    [
      "Markets",
      "Singapore · Asia Pacific"
    ]
  ],
  "note": "Agree who owns each metric, how often it updates and how the team will check its accuracy."
};
---
<ServicePage title={title} current="platforms-analytics" description="Business-led marketing technology and analytics advisory: requirements, measurement, vendor coordination and governance.">
  <ServiceHero slot="introduction" {...hero} enquiryHref={`/?service=${encodeURIComponent(title)}#enquiry`} />
</ServicePage>
