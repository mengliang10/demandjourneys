---
const decks=[
  {
    slug:'booking-transformation',
    title:'Enterprise booking experience transformation',
    subtitle:'Frasers Hospitality · Project Meta',
    status:'Implemented programme',
    problem:'A global booking experience needed a clearer, faster customer journey and more consistent digital infrastructure.',
    remit:'Concept, business case, Board approval and implementation governance across web and booking systems.',
    evidence:['Page-load time improved from approximately 7.1 to 3.0 seconds.','Booking journey reduced from approximately 10 steps to 5.','Direct website room nights increased by 56% in the documented programme context.'],
    caution:'Programme-associated outcomes, not proof of causal attribution to a single change. Figures are subject to original measurement scope.',
    sections:['Context and decision criteria','Booking journey before / after','Architecture and delivery approach','Measurement and governance','Sources and approved evidence']
  },
  {
    slug:'customer-data-platform',
    title:'Customer data platform strategy',
    subtitle:'Hospitality customer-platform planning',
    status:'Planned and specified · Not deployed',
    problem:'Customer identity, lifecycle activity and measurement required an integrated platform decision framework.',
    remit:'CDP concept, requirements, architecture, roadmap, RFP, business case and implementation planning.',
    evidence:['Business and platform requirements translated into an implementation roadmap.','Vendor evaluation and procurement planning completed.'],
    caution:'Full approval and deployment were not completed before departure. No production unified guest profile or realised benefit is claimed.',
    sections:['Use cases and decision requirements','Data sources, privacy and identity','RFP and vendor evaluation','Proposed architecture and phases','Planning evidence and limitations']
  },
  {
    slug:'distribution-governance',
    title:'Regional distribution and media governance',
    subtitle:'Hospitality and travel · APAC',
    status:'Leadership and operating experience',
    problem:'Direct commerce, OTA distribution, paid media and commercial reporting needed coordinated governance across markets.',
    remit:'Regional marketing and channel oversight, selected chain agreements, forecasting and cross-functional governance.',
    evidence:['Direct involvement in chain distribution agreements with major online travel agencies.','Forecasting responsibilities spanning weekly through long-range planning.'],
    caution:'Property-level OTA execution remained locally owned. Revenue management was shared governance, not sole functional ownership.',
    sections:['Markets, teams and operating scope','Channel economics and distribution governance','Media and agency management','Measurement, forecasting and cadence','Role ownership and evidence boundaries']
  }
];
export function getStaticPaths(){return ['booking-transformation','customer-data-platform','distribution-governance'].map(slug=>({params:{slug}}));}
const deck=decks.find(item=>item.slug===Astro.params.slug);
const site='https://www.demandjourneys.com';
const deckURL=`${site}/selected-work/decks/${deck.slug}/`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content={`Evidence-qualified presentation placeholder: ${deck.title}. Scope, evidence and limitations are included; full case materials forthcoming.`}/>
<link rel="canonical" href={deckURL}/>
<title>{deck.title} | Selected Work | Demand Journeys</title>
<link rel="stylesheet" href="/hospitality-presentations/personal-portfolio/vendor/reveal.min.css"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"/>
<style is:global>
:root{--ink:#203e3a;--teal:#237e72;--paper:#f5f2e9;--muted:#60716a;--line:#d5dcd1;--orange:#b45a34;--gold:#927448;--dj-font-display:'Newsreader',Georgia,serif;--dj-font-body:'DM Sans',Arial,Helvetica,sans-serif}
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0;background:var(--paper);color:var(--ink);font-family:var(--dj-font-body)}
html:fullscreen,html:fullscreen body,html:fullscreen .reveal{background:var(--paper)}
a{color:inherit;text-decoration:none}
header,.bottom{position:fixed;left:4%;right:4%;z-index:30;display:flex;align-items:center;justify-content:space-between;font-size:11px;letter-spacing:1.8px}
header{top:24px;gap:15px}header>a{font-weight:800;letter-spacing:2px;display:inline-flex;align-items:center;gap:10px}
header>a:before{content:none;display:none}
header span{color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
header .header-actions{display:flex;gap:10px;align-items:center}
button,.presentation-action{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:24px;padding:8px 14px;cursor:pointer;white-space:nowrap;letter-spacing:.5px}
button:hover,.presentation-action:hover{background:#d9e5d9}
a:focus-visible,button:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
.bottom{bottom:19px}
.bottom>div{display:flex;gap:18px;align-items:center}
.bottom button{font-size:19px;padding:3px 14px}
.reveal,.reveal-viewport{background:var(--paper);color:var(--ink)}
.reveal{font-size:22px}
.reveal .slides{text-align:left}
.reveal .slides section{height:650px;padding:28px 26px 44px;text-align:left}
.reveal h1,.reveal h2{font-family:var(--dj-font-display);font-weight:400;text-transform:none;letter-spacing:-1.7px;line-height:1.06;margin:14px 0 28px;color:inherit;max-width:1100px}
.reveal h1{font-size:62px}
.reveal h2{font-size:53px}
.reveal p{font-size:21px;line-height:1.42;margin:14px 0}
.reveal .lead{font-size:23px;line-height:1.45;color:var(--muted);max-width:930px}
.reveal ul{padding-left:22px;margin:20px 0}
.reveal li{font-size:20px;line-height:1.36;margin:11px 0}
.reveal .eyebrow{font-size:11px;letter-spacing:2px;font-weight:600;color:var(--teal);margin-bottom:22px;display:block;text-transform:uppercase}
.reveal .dark{color:var(--ink)}
.reveal .dark h1,.reveal .dark h2{color:var(--ink)}
.reveal .dark .lead{color:var(--muted)}
.reveal .subtitle{color:var(--muted);font-size:16px;margin-top:23px}
.reveal .tag{display:inline-block;border:1px solid #a8bba8;border-radius:24px;padding:10px 18px;margin-top:32px;font-size:14px;letter-spacing:.3px;color:var(--teal)}
.reveal .boundary{margin-top:29px;padding:15px 20px;border-left:3px solid var(--orange);background:#e8ede4;font-size:16px;line-height:1.5;max-width:1000px}
.reveal .placeholder{border:1px dashed #a6b8a6;background:#e8ede4;padding:22px 27px;max-width:1050px}
.reveal .placeholder strong{display:block;font-size:18px;margin-bottom:8px}
.reveal .placeholder p{font-size:17px;margin:6px 0}
.reveal .placeholder ul{margin:9px 0}
.reveal .placeholder li{font-size:16px;line-height:1.23;margin:5px 0}
.reveal .progress{height:3px;color:var(--teal)}
.reveal .controls{display:none}
/* Production wordmark used by the main Demand Journeys website. */
.presentation-header>a:first-child{font-size:0;letter-spacing:0;line-height:0;min-width:180px;min-height:30px;background:url('/identity/wordmark-forest-456.webp') left center/180px auto no-repeat}
@media(max-width:650px){.presentation-header>a:first-child{min-width:126px;min-height:24px;background-size:126px auto}}
@media(max-width:650px){header{top:12px;left:3%;right:3%;gap:7px}header>a{font-size:9px;letter-spacing:.6px;max-width:140px}header>a:before{width:19px;height:19px}header>span{display:none}.header-actions{gap:5px!important}.header-actions button,.header-actions a{font-size:10px;padding:8px 9px}.bottom{bottom:10px;font-size:9px;left:3%;right:3%}.bottom>div{gap:8px}.bottom button{padding:3px 11px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
@media print{header,.bottom{display:none}.reveal .slides section{padding-top:20px}}
</style>
</head>
<body>
<header class="presentation-header">
<a href="/selected-work/" aria-label="Back to Selected Work">DEMAND JOURNEYS / SELECTED WORK</a>
<span>{deck.title.toUpperCase()}</span>
<div class="header-actions">
<button type="button" id="present" aria-label="Enter presentation fullscreen mode">Present ⛶</button>
<button type="button" id="overview" aria-label="Show slide overview">Overview ⊞</button>
</div>
</header>
<div class="reveal" aria-label={`Reveal.js presentation for ${deck.title}`}>
<div class="slides">

<section class="dark">
<span class="eyebrow">Demand Journeys / Selected work</span>
<h1>{deck.title}</h1>
<p class="lead">{deck.subtitle}</p>
<span class="tag">{deck.status}</span>
<p class="subtitle">Presentation framework · Placeholder edition</p>
</section>
<section>
<span class="eyebrow">01 / Business context</span>
<h2>The challenge</h2>
<p class="lead">{deck.problem}</p>
<div class="boundary">Detailed context, chronology and supporting visuals will be inserted after the public-use evidence review.</div>
</section>
<section>
<span class="eyebrow">02 / Scope</span>
<h2>What the work covered</h2>
<p class="lead">{deck.remit}</p>
<div class="boundary">This scope describes professional work in earlier roles, not necessarily a Demand Journeys consulting engagement.</div>
</section>
<section>
<span class="eyebrow">03 / Evidence</span>
<h2>What is supported today</h2>
<ul>{deck.evidence.map(item=><li>{item}</li>)}</ul>
<div class="boundary">{deck.caution}</div>
</section>
<section>
<span class="eyebrow">04 / To complete</span>
<h2>Case-study materials pending</h2>
<div class="placeholder"><strong>Placeholder for the full Reveal.js case deck</strong><p>The next edition will develop the following sections using approved, non-confidential material:</p>
<ul>{deck.sections.map(item=><li>{item}</li>)}</ul></div>
</section>
<section class="dark">
<span class="eyebrow">Demand Journeys / Evidence-first thinking</span>
<h2>From operating experience to defensible decisions.</h2>
<p class="lead">Explore the broader selected-work evidence and advisory scope.</p>
<p><a style="color:inherit;text-decoration:underline" href="/selected-work/">Return to Selected Work</a></p>
<p class="subtitle">Placeholder deck · No financial revenue amounts or service prices</p>
</section>

</div></div>
<nav class="bottom" aria-label="Slide navigation">
<span id="chapter">SELECTED WORK</span>
<div><button type="button" id="prev" aria-label="Previous slide">←</button><span id="count" aria-live="polite">01 / 06</span><button type="button" id="next" aria-label="Next slide">→</button></div>
</nav>
<script is:inline src="/hospitality-presentations/personal-portfolio/vendor/reveal.min.js"></script>
<script is:inline>
if (typeof Reveal !== 'undefined') {
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ready=Reveal.initialize({
    width:1200,height:700,margin:.12,hash:true,controls:false,progress:true,center:false,
    transition:reduced?'none':'fade',backgroundTransition:'none',
    keyboardCondition:e=>!['INPUT','TEXTAREA','SELECT'].includes(e.target?.tagName)
  });
  const chapter=document.getElementById('chapter');
  const count=document.getElementById('count');
  function status(){
    const current=Reveal.getCurrentSlide();
    if(!current)return;
    count.textContent=String(Reveal.getIndices().h+1).padStart(2,'0')+' / '+String(Reveal.getTotalSlides()).padStart(2,'0');
    chapter.textContent=current.querySelector('.eyebrow')?.textContent||'SELECTED WORK';
  }
  ready.then(status);
  Reveal.on('slidechanged',status);
  document.getElementById('next').addEventListener('click',()=>Reveal.next());
  document.getElementById('prev').addEventListener('click',()=>Reveal.prev());
  document.getElementById('overview').addEventListener('click',()=>Reveal.toggleOverview());
  const button=document.getElementById('present');
  button.addEventListener('click',async()=>{
    try{
      if(document.fullscreenElement)await document.exitFullscreen();
      else await document.documentElement.requestFullscreen();
    }catch(e){
      // In restricted embeds, open the standalone deck instead of showing a broken fullscreen state.
      if(window.self!==window.top)window.open(location.href,'_blank','noopener');
    }
  });
  function syncFullscreen(){
    const full=Boolean(document.fullscreenElement);
    button.textContent=full?'Exit fullscreen':'Present ⛶';
    button.setAttribute('aria-label',full?'Exit presentation fullscreen mode':'Enter presentation fullscreen mode');
    requestAnimationFrame(()=>Reveal.layout());
  }
  document.addEventListener('fullscreenchange',syncFullscreen);
  window.addEventListener('resize',()=>requestAnimationFrame(()=>Reveal.layout()));
}
</script>
</body>
</html>
