---
import { getImage } from 'astro:assets';
import desktop from '../assets/splash.jpg';
import mobile from '../assets/splash-mobile.jpg';
const desktopWidths=[960,1440,1920];
const mobileWidths=[390,640,900];
const make=async (src,widths)=>Promise.all(widths.map(width=>getImage({src,width,format:'webp',quality:74})));
const [large,small]=await Promise.all([make(desktop,desktopWidths),make(mobile,mobileWidths)]);
---
<picture class="hero-background" aria-hidden="true">
 <source media="(max-width:760px)" srcset={small.map((img,i)=>`${img.src} ${mobileWidths[i]}w`).join(', ')} sizes="100vw"/>
 <img src={large[1].src} srcset={large.map((img,i)=>`${img.src} ${desktopWidths[i]}w`).join(', ')} sizes="100vw" width={desktop.width} height={desktop.height} alt="" fetchpriority="high" loading="eager" decoding="async"/>
</picture>
<style is:global>
body.final-home .hero::before{background:none}
.hero-background{position:absolute;inset:0;z-index:-2;display:block;pointer-events:none}
.hero-background img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 51%}
@media(max-width:760px){.hero-background img{object-position:53% center}}
body.interior .deck-preview picture{display:block;width:100%;height:100%}
</style>
