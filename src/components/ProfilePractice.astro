---
const results = [
  ['US$50M+', 'Annual online sales through the channel I managed at Frasers Hospitality, within a US$200M+ portfolio.'],
  ['+56%', 'Growth in direct website bookings at Frasers in one year, measured in room nights.'],
  ['7.1s → 3.0s', 'Website load time after a S$5.5M transformation. Checkout fell from about ten steps to five.'],
  ['US$25M', 'Advertising managed across APAC at HomeAway / Expedia and Accor. The Japan launch returned 3× ad spend.']
];
const roles = [
  ['2024–now', 'Demand Journeys', 'Fractional growth advisor', 'AI discovery, marketplaces and digital commerce.'],
  ['2018–2024', 'Frasers Hospitality', 'VP, Global Digital Marketing & Distribution', '70+ properties across 13 markets.'],
  ['2016–2018', 'HomeAway / Expedia', 'Head of Performance Marketing, APAC', 'US$15M advertising across seven markets.'],
  ['2013–2016', 'AccorHotels', 'Head of Paid Search & Analytics, APAC', '600+ hotels and US$10M in media. Agency fees cut by 5%.'],
  ['2010–2012', 'TripAdvisor', 'Senior Search Analyst, APAC', 'Regional traffic grew 150% year on year.']
];
const earlier = [
  ['2010', 'GroupM / MediaCom', 'Search lead for Dell’s APAC regional media portfolio, including agency governance.'],
  ['2008–2010', 'Singapore Press Holdings', 'Digital marketing and online ad operations for direct portals and campaign delivery.'],
  ['2003–2004', 'Raffles International', 'CRM and loyalty marketing, including the global customer database and campaign operations.']
];
const engagements = [
  ['Diagnostic sprint', '2–3 weeks', 'Audit analytics, find the biggest constraint and deliver a costed 90-day plan.'],
  ['Fractional leader', '2–3 days a week, 90–120 days', 'Lead delivery from inside the team and coach the people who take over.'],
  ['Strategic advisor', 'Monthly', 'Review decisions with executives and the board. Guide marketing capital allocation.'],
  ['Interim cover', '3–6 months', 'Hold the leadership role and stabilise performance while a permanent executive is found.']
];
---
<article class="practice-story" aria-labelledby="results-title">
  <section class="block" aria-labelledby="results-title">
    <p class="kicker">Track record</p>
    <h2 id="results-title">Twenty years of commercial results across Asia Pacific</h2>
    <dl class="results">{results.map(([figure, text]) => <div><dt>{figure}</dt><dd>{text}</dd></div>)}</dl>
    <p class="note">Figures are reported against employer records. The Frasers sales figure describes channel governance within a wider business.</p>
  </section>
  <section class="block" aria-labelledby="career-title">
    <p class="kicker">Career</p>
    <h2 id="career-title">Where that experience comes from</h2>
    <ol class="timeline">{roles.map(([years, company, title, detail]) => <li><span class="years">{years}</span><div><strong>{company}</strong><span class="title">{title}</span><span class="detail">{detail}</span></div></li>)}</ol>
    <details class="earlier">
      <summary>Earlier roles</summary>
      <ol class="timeline">{earlier.map(([years, company, detail]) => <li><span class="years">{years}</span><div><strong>{company}</strong><span class="detail">{detail}</span></div></li>)}</ol>
    </details>
  </section>
  <section class="block" aria-labelledby="work-title">
    <p class="kicker">Working together</p>
    <h2 id="work-title">Four ways to work with me</h2>
    <p class="lead">I take hands-on CMO, CXO, CDMO, CRO and CGO mandates across APAC, and stay responsible for delivery throughout.</p>
    <ul class="options">{engagements.map(([name, length, text]) => <li><strong>{name}</strong><span class="length">{length}</span><p>{text}</p></li>)}</ul>
    <p class="note">I lead commercial strategy, performance advertising, conversion design, marketing technology, partner distribution, spend governance and team training. Production engineering, core infrastructure, legal counsel and enterprise direct sales are covered by specialists, agreed at the outset.</p>
  </section>
  <section class="cta" aria-labelledby="cta-title">
    <div>
      <h2 id="cta-title">Want the full approach?</h2>
      <p>The PDF covers my customer-journey method, channel economics, 12-week plan and handover.</p>
    </div>
    <div class="cta-actions">
      <a class="cta-primary" href="/#enquiry">Discuss a fractional mandate <span aria-hidden="true">↗</span></a>
      <a class="cta-secondary" href="/tan-meng-liang-professional-introduction.pdf" download>Download profile · PDF <span aria-hidden="true">↓</span></a>
    </div>
  </section>
</article>
<style>
  .practice-story { color:var(--ink); padding:8px 0 36px; }
  .practice-story .block { padding:clamp(28px,4vw,48px) 0; border-top:1px solid var(--line); }
  .practice-story .kicker { margin:0 0 8px; font:600 12px/1.4 Editorial,Arial,sans-serif; letter-spacing:.08em; text-transform:uppercase; color:var(--accent); }
  .practice-story h2 { margin:0 0 22px; max-width:28ch; font:500 clamp(26px,2.8vw,34px)/1.2 Outfit,Arial,sans-serif; letter-spacing:-.02em; }
  .practice-story p { font-size:16px; line-height:1.65; }
  .practice-story .lead { max-width:68ch; margin:-6px 0 24px; color:var(--muted); }
  .practice-story .note { max-width:78ch; margin:22px 0 0; font-size:13px; line-height:1.6; color:var(--muted); }
  .results { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin:0; }
  .results > div { padding:20px; background:#fff; border:1px solid var(--line); border-radius:6px; }
  .results dt { font:500 clamp(28px,3vw,36px)/1.1 Outfit,Arial,sans-serif; letter-spacing:-.02em; color:#315b4b; }
  .results dd { margin:10px 0 0; font-size:14px; line-height:1.6; color:var(--muted); }
  .timeline { margin:0; padding:0; list-style:none; }
  .timeline li { display:grid; grid-template-columns:110px minmax(0,1fr); gap:24px; padding:16px 0; border-top:1px solid var(--line); }
  .timeline li:first-child { border-top:0; padding-top:0; }
  .timeline .years { font:600 13px/1.6 Editorial,Arial,sans-serif; color:var(--accent); }
  .timeline strong { display:block; font:500 19px/1.3 Outfit,Arial,sans-serif; }
  .timeline .title { display:block; margin-top:2px; font-size:15px; line-height:1.5; }
  .timeline .detail { display:block; margin-top:2px; font-size:14px; line-height:1.55; color:var(--muted); }
  .earlier { margin-top:8px; border-top:1px solid var(--line); }
  .earlier summary { display:flex; align-items:center; gap:10px; padding:16px 0; cursor:pointer; list-style:none; font:500 17px/1.3 Outfit,Arial,sans-serif; }
  .earlier summary::-webkit-details-marker { display:none; }
  .earlier summary::after { content:'+'; font-size:22px; line-height:1; color:var(--accent); }
  .earlier[open] summary::after { content:'−'; }
  .earlier summary:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
  .earlier .timeline li:first-child { padding-top:16px; border-top:1px solid var(--line); }
  .options { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin:0; padding:0; list-style:none; }
  .options li { padding:20px; background:#fff; border:1px solid var(--line); border-radius:6px; }
  .options strong { display:block; font:500 20px/1.3 Outfit,Arial,sans-serif; }
  .options .length { display:inline-block; margin:8px 0 12px; padding:3px 10px; border-radius:999px; background:#e8eee8; font:600 12px/1.5 Editorial,Arial,sans-serif; color:#315b4b; }
  .options p { margin:0; font-size:14px; line-height:1.6; color:var(--muted); }
  .cta { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:24px 40px; padding:clamp(24px,4vw,40px); border-radius:10px; background:#203e35; color:#fff; }
  .cta h2 { margin:0 0 6px; color:inherit; font-size:clamp(24px,2.6vw,30px); }
  .cta p { margin:0; max-width:52ch; color:#eef5ef; font-size:15px; }
  .cta-actions { display:flex; flex-wrap:wrap; gap:12px; }
  .cta-actions a { display:inline-block; padding:12px 20px; border-radius:5px; font-size:15px; text-decoration:none; }
  .cta-primary { background:#fff; color:#203e35; }
  .cta-secondary { border:1px solid rgba(255,255,255,.55); color:#fff; }
  .cta-actions a:focus-visible { outline:2px solid #fff; outline-offset:3px; }
  @media(max-width:1000px){ .results,.options { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:620px){
    .results,.options { grid-template-columns:1fr; gap:12px; }
    .timeline li { grid-template-columns:1fr; gap:2px; }
    .cta-actions { width:100%; flex-direction:column; }
    .cta-actions a { text-align:center; }
  }
</style>
