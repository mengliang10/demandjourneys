---
const roles = [
  ['2024–present', 'Demand Journeys', 'Fractional growth advisor across AI discovery, marketplaces and digital commerce.'],
  ['2018–2024', 'Frasers Hospitality', 'VP, Global Digital Marketing & Distribution. Oversaw direct channels across 70+ properties in 13 markets, with US$50M+ in annual online sales.'],
  ['2016–2018', 'HomeAway / Expedia', 'Head of Performance Marketing, APAC. Managed US$15M in advertising across seven markets. The Japan launch returned 3× ad spend.'],
  ['2013–2016', 'AccorHotels', 'Head of Paid Search & Analytics, APAC. Covered 600+ hotels and US$10M in media, and reduced agency fees by 5%.'],
  ['2010–2012', 'TripAdvisor', 'Senior Search Analyst, APAC. Regional traffic grew 150% year on year.'],
  ['2010', 'GroupM / MediaCom', 'Search lead for Dell’s APAC regional media portfolio, including agency governance.'],
  ['2008–2010', 'Singapore Press Holdings', 'Digital marketing and online ad operations for direct portals and campaign delivery.'],
  ['2003–2004', 'Raffles International', 'CRM and loyalty marketing, including the global customer database and campaign operations.']
];
const stages = [
  ['Awareness', 'People find you through search, partners, advertising or word of mouth. High traffic can hide weak buying intent. Trace each source to verified buyers.'],
  ['Registration', 'Account creation, email verification and permissions establish who signed up. Exclude fake and automated accounts before judging demand.'],
  ['First value', 'A customer completes onboarding and uses the core feature. Watch where setup becomes difficult and shorten the path to that first useful result.'],
  ['First payment', 'Follow the first order through checkout to a confirmed receipt. Unexpected prices and payment failures cost sales. Simplifying checkout can turn ten steps into five.'],
  ['Repeat buyer', 'Customers reorder, renew or refer someone else. A returning buyer can avoid another paid acquisition. Track repeat purchases and lifetime value.']
];
const systems = [
  ['Customer journey audit', 'Map the steps from first contact to payment. Use drop-off analysis, shared metric definitions and conversations with the team to find the cause before increasing spend.'],
  ['Channel quality and mix', 'Move spend towards sources that bring buyers. Combine high-intent search, organic reach and partner co-marketing, with clear rules for who can change budgets.'],
  ['Onboarding and conversion', 'Speed up slow pages, simplify sign-up and checkout, and repair tracking so each campaign can be traced to real users.'],
  ['Customer unit economics', 'Calculate profit per customer after delivery, payment fees, support and marketing costs. Use payback time to set spending limits.'],
  ['Repeat buyers and retention', 'Use automated messages, loyalty triggers and partner renewals to encourage a second purchase. Measure repeat purchase rate and margin.'],
  ['Team coaching and transfer', 'Name an internal owner for each decision. Use Monday reviews, written playbooks and shadowing to practise interpreting reports and running experiments.']
];
const channels = [
  ['Direct inbound & SEO', 'Actively searching', 'Low, compounding', 'Under 2 months', '70–85%'],
  ['Partner distribution & B2B2C', 'Trust established by partner', 'Moderate, shared', '3–5 months', '55–70%'],
  ['Paid performance advertising', 'Variable intent', 'High, competitive', '6–10 months', '35–50%'],
  ['Referrals & brand advocacy', 'Warm word of mouth', 'Very low or zero media cost', 'Immediate', '80–90%'],
  ['Blended mix', 'Balanced across sources', 'Managed as a portfolio', 'Target under 6 months', 'Positive overall profit']
];
const gates = [
  ['Week 0', 'Authority', 'Secure logins, data access and sign-off authority. Audit tracking and channels, and schedule the weekly review.'],
  ['Week 1', 'Baseline', 'Repair tracking and check whether the team can trust the figures it will use to make decisions.'],
  ['Week 2', 'Root cause', 'Agree on the main constraint and the first small tests. I begin chairing reviews with the team.'],
  ['Weeks 3–4', 'First results', 'Agree on the core metrics and use live tests to see whether the change generates cash.'],
  ['Weeks 5–8', 'Capacity to scale', 'Expand profitable tests, reconcile reports with bank deposits monthly and test whether operations and technology can handle 3–5× the volume. The team begins leading reviews.'],
  ['Weeks 9–12', 'Handover', 'In weeks 9–10 we document what worked. In weeks 11–12 the team chairs every review and runs the process independently while I observe and coach.']
];
const meetings = [
  ['Monday · 45 minutes', 'Growth review', 'Review last week’s results and blockers. Make one decision the team can act on now.'],
  ['Midweek · 30 minutes', 'Delivery check-in', 'Resolve dependencies across marketing, product, technology and finance.'],
  ['Fortnightly', 'CEO review', 'Agree budget allocation, partner contracts and growth risks.'],
  ['Monthly', 'Profit review', 'Check net profit by channel against receipts. Reallocate spend and update the forecast.'],
  ['Final two weeks', 'Team-led reviews', 'Internal owners chair the meetings. I observe and coach so the team is ready for day 91.']
];
const assets = [
  ['Metric dictionary', 'Agreed formulas for acquisition cost, conversion and net revenue.'],
  ['Tracking runbook', 'Server telemetry, event specifications and QA checklists.'],
  ['Experiment archive', 'Hypotheses, tests, results and realised profit lift.'],
  ['Partner playbook', 'Procedures for launching, negotiating and scaling partnerships.'],
  ['Customer profit model', 'A working spreadsheet for calculating unit economics.'],
  ['6–12 month growth plan', 'Prioritised milestones and a roadmap for allocating capital.']
];
---
<article class="practice-story" aria-labelledby="practice-story-title">
  <header class="story-opening">
    <div><p class="kicker">Fractional commercial leadership</p><h2 id="practice-story-title">How I work alongside your team</h2></div>
    <p>The portfolio shows how I approach a commercial problem. In a fractional role, I stay with the team through the next decisions: where customers are getting stuck, which change earns its cost, and who will keep the work going once I leave.</p>
  </header>

  <section class="chapter">
    <h3>Twenty years of commercial decisions across Asia Pacific</h3>
    <p>Based in Singapore, I take hands-on CMO, CXO, CDMO, CRO and CGO mandates across APAC. I work directly with teams in B2C and B2B2C marketplaces, travel and mobility, digital commerce and consumer platforms. I stay responsible for delivery throughout the engagement.</p>
    <dl class="proof">
      <div><dt>US$50M+</dt><dd>Annual online sales through the channel I managed within a US$200M+ portfolio at Frasers Hospitality.</dd></div>
      <div><dt>56%</dt><dd>Growth in direct website bookings at Frasers in one year, measured in room nights. The following year was pacing at +42%.</dd></div>
      <div><dt>7.1s → 3.0s</dt><dd>Website load time after a S$5.5M transformation project. Checkout fell from about ten steps to five.</dd></div>
      <div><dt>US$25M</dt><dd>Advertising spend managed across APAC at HomeAway / Expedia and Accor. The Japan launch achieved a 3× return on ad spend.</dd></div>
    </dl>
    <p class="note">The profile reports these figures against employer records. The portfolio figures describe channel governance within a wider business. Booking growth measures room nights.</p>
    <h4>Where that experience comes from</h4>
    <dl class="record">{roles.map(([years, company, role]) => <div><dt><small>{years}</small>{company}</dt><dd>{role}</dd></div>)}</dl>
  </section>

  <section class="chapter">
    <h3>Follow a customer from discovery to a second purchase</h3>
    <p>Across those roles, the most useful starting point was often a single customer journey. If a campaign is bringing people to the site, I want to see what happens between that visit and money arriving in the bank.</p>
    <figure class="journey">
      <figcaption>The five places I look for lost demand</figcaption>
      <ol>{stages.map(([name, text]) => <li><strong>{name}</strong><p>{text}</p></li>)}</ol>
    </figure>
    <p>The journey tells us where to look. The weekly review connects what we learn at the start of that journey to the two outcomes that matter at the other end: returning buyers and cash after costs.</p>
    <figure class="operating-model">
      <figcaption>How the weekly review connects demand to profit</figcaption>
      <div class="operating-flow">
        <div class="flow-pair"><div><strong>Find real customers</strong><p>Search, partners and targeted advertising</p></div><div><strong>Remove buying friction</strong><p>A fast site, easy sign-up and clear pricing</p></div></div>
        <div class="flow-review"><strong>Weekly operating review</strong><p>Diagnose losses on Monday. Unblock the fix midweek and coach the team as it implements the change.</p></div>
        <div class="flow-pair"><div><strong>Bring customers back</strong><p>Loyalty triggers and partner renewals</p></div><div><strong>Check cash in the bank</strong><p>Revenue after delivery, fees and acquisition costs</p></div></div>
      </div>
      <p class="note">Receipts from first and repeat purchases feed the next week’s allocation.</p>
    </figure>
    <h4>Six practical systems behind the review</h4>
    <dl class="pairs">{systems.map(([name, text]) => <div><dt>{name}</dt><dd>{text}</dd></div>)}</dl>
  </section>

  <section class="chapter">
    <h3>Decide which customers you can afford to acquire</h3>
    <p>Finding the leak tells us where to intervene. Channel economics tell us whether buying more demand makes sense. These are the comparison ranges I use in the introduction, to be checked against the business’s own receipts and costs.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Channel economics comparison">
      <table><caption>Channel economics at a glance</caption><thead><tr>{['Acquisition channel','Buyer intent','Cost to acquire','Payback','Net margin'].map(label => <th scope="col">{label}</th>)}</tr></thead>
        <tbody>{channels.map(([name,...cells]) => <tr><th scope="row">{name}</th>{cells.map(cell => <td>{cell}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <p>Partner distribution and organic search can lower blended acquisition cost. That advantage depends on reliable source tracking and verified commercial agreements. I review paid campaigns separately so free referrals cannot conceal losses.</p>
    <figure class="formula"><figcaption>Profit per customer</figcaption><p>Cash received − delivery or service costs − payment and platform fees − customer support − attributable acquisition costs, including media and commissions.</p></figure>
    <p>We reconcile this calculation to bank receipts and ledgers each month. If sign-up is broken or a sale loses money after costs, repairing it before spending more protects the budget for channels that can scale.</p>
  </section>

  <section class="chapter">
    <h3>Turn the diagnosis into a 12-week plan</h3>
    <p>I spend the first two weeks auditing the numbers and listening to the team. In weeks 3–10 we redesign and test the constraint, whether it is checkout, tracking, a partner deal or the ad mix. The last two weeks belong to the people who will run the reviews, read the dashboards and make decisions after handover.</p>
    <figure class="roadmap"><figcaption>Six checkpoints across measurement, growth testing and team coaching</figcaption>
      <ol>{gates.map(([when, name, text]) => <li><small>{when}</small><div><strong>{name}</strong><p>{text}</p></div></li>)}</ol>
    </figure>
    <h4>What the evidence lets us decide</h4>
    <dl class="record"><div><dt>Scale</dt><dd>Increase investment when cash receipts confirm a profitable path and the team can handle the extra volume.</dd></div><div><dt>Repair</dt><dd>Stop spending where acquisition loses money. Fix the cause and return the saved capital to the business.</dd></div><div><dt>Pivot</dt><dd>Use customer evidence to change pricing or the audience when the original economics fail. An early decision can save a year of pursuing the wrong market.</dd></div></dl>
  </section>

  <section class="chapter">
    <h3>Give the team a rhythm it can keep</h3>
    <p>Handover starts with the first review. We use the same meeting rhythm throughout the engagement, gradually moving the chair from me to an internal owner.</p>
    <dl class="record">{meetings.map(([time,name,text]) => <div><dt><small>{time}</small>{name}</dt><dd>{text}</dd></div>)}</dl>
    <h4>What stays with you on day 91</h4>
    <dl class="pairs">{assets.map(([name,text]) => <div><dt>{name}</dt><dd>{text}</dd></div>)}</dl>
  </section>

  <section class="chapter">
    <h3>Choose the level of support your team needs</h3>
    <p>Some teams need a short investigation. Others need someone in the leadership seat while the work gets done. The scope depends on the decision, the people available and who will own delivery.</p>
    <dl class="pairs">
      <div><dt>Diagnostic sprint <small>2–3 weeks</small></dt><dd>Audit analytics, identify the largest constraint and deliver a costed 90-day execution plan.</dd></div>
      <div><dt>Fractional leader <small>2–3 days a week for 90–120 days</small></dt><dd>Lead implementation from inside the team, run weekly delivery and coach the people taking ownership.</dd></div>
      <div><dt>Strategic advisor <small>Monthly</small></dt><dd>Review decisions with executives and the board, challenge assumptions and guide marketing capital allocation.</dd></div>
      <div><dt>Interim cover <small>3–6 months</small></dt><dd>Hold the leadership role and stabilise performance during the search for a permanent executive.</dd></div>
    </dl>
    <p>I lead commercial strategy, performance advertising, conversion design, marketing technology, partner distribution, spend governance and team training. I bring in specialists for production engineering, core infrastructure, legal counsel and enterprise direct sales. We agree those responsibilities at the outset.</p>
    <a class="story-link" href="/#enquiry">Discuss a fractional mandate <span aria-hidden="true">↗</span></a>
  </section>
</article>
<style>
  .practice-story { color:var(--ink); padding-bottom:36px; }
  .story-opening { display:grid; grid-template-columns:1fr 1fr; align-items:end; gap:clamp(24px,5vw,72px); padding:clamp(25px,4vw,55px); border-radius:10px; background:#203e35; color:#fff; }
  .practice-story .kicker { color:#cbdfd2; letter-spacing:.08em; text-transform:uppercase; font-size:12px; margin:0 0 14px; }
  .story-opening h2 { color:inherit; font:500 clamp(30px,3.5vw,48px)/1.1 Outfit,sans-serif; margin:0; }
  .practice-story .story-opening > p { color:#eef5ef; margin:0; }
  .chapter { width:100%; min-width:0; margin:0; padding:clamp(32px,5vw,64px) 0; border-bottom:1px solid var(--line); }
  .chapter h3 { font:500 clamp(27px,3vw,38px)/1.16 Outfit,sans-serif; letter-spacing:-.025em; max-width:30ch; margin:0 0 18px; }
  .chapter h4, figcaption, caption { font:500 21px/1.3 Outfit,sans-serif; text-align:left; margin:26px 0 14px; }
  .practice-story p,.practice-story dd { font-size:16px; line-height:1.65; }
  .chapter > p { max-width:78ch; margin:16px 0; }
  .practice-story dl,.practice-story figure { margin:24px 0; }
  .practice-story dd { margin:6px 0 0; color:var(--muted); }
  .practice-story dt,.practice-story li strong { font:500 20px/1.3 Outfit,sans-serif; }
  .practice-story small { display:block; font:600 12px/1.45 Editorial,Arial,sans-serif; color:var(--accent); margin:3px 0; }
  .proof,.pairs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 32px; }
  .proof>div,.pairs>div,.record>div { border-top:1px solid var(--line); padding:16px 0; }
  .proof dt { font-size:32px; color:#315b4b; }
  .record>div { display:grid; grid-template-columns:minmax(170px,1fr) 2.6fr; gap:24px; align-items:baseline; }
  .record dd { margin:0; }
  .practice-story .note { font-size:13px; color:var(--muted); }
  .journey ol { padding:0; display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); list-style:none; gap:16px; counter-reset:stage; }
  .journey li { position:relative; padding-top:14px; border-top:2px solid #78998a; counter-increment:stage; }
  .journey li::before { content:counter(stage,decimal-leading-zero); display:block; font-size:13px; color:var(--accent); margin-bottom:8px; }
  .journey li:not(:last-child)::after { content:'→'; position:absolute; right:0; top:9px; color:var(--accent); }
  .practice-story li p { font-size:15px; margin:8px 0; }
  .table-wrap { overflow:auto; }
  table { width:100%; border-collapse:collapse; font-size:15px; line-height:1.5; min-width:640px; }
  th,td { text-align:left; padding:12px; border-bottom:1px solid var(--line); }
  thead,tr:last-child { background:#e8eee8; }
  .formula { background:#e4ede5; padding:22px 28px; border-left:3px solid var(--accent); }
  .formula figcaption,.formula p { margin:0; } .formula p { margin-top:8px; max-width:76ch; }
  .operating-flow { display:grid; grid-template-columns:1fr 1.1fr 1fr; gap:32px; align-items:stretch; }
  .flow-pair { display:grid; gap:8px; }
  .flow-pair > div,.flow-review { padding:16px; border-radius:6px; background:#e8eee8; }
  .flow-review { position:relative; display:flex; flex-direction:column; justify-content:center; background:#203e35; color:white; }
  .flow-review::before,.flow-review::after { content:'→'; position:absolute; top:45%; color:var(--accent); font-size:22px; }
  .flow-review::before { left:-26px; } .flow-review::after { right:-26px; }
  .operating-flow strong {font:500 18px/1.3 Outfit,sans-serif;}
  .operating-flow p {margin:5px 0 0;font-size:14px;color:inherit;}
  @media(max-width:760px){.operating-flow {grid-template-columns:1fr; gap:24px;} .flow-pair {grid-template-columns:1fr 1fr;} .flow-review::before,.flow-review::after {content:'↓';left:50%;right:auto;line-height:24px;} .flow-review::before {top:-24px;} .flow-review::after {top:auto;bottom:-24px;}}
  .roadmap ol { margin:0; padding:0 0 0 18px; list-style:none; border-left:2px solid #aabfb1; }
  .roadmap li { position:relative; display:grid; grid-template-columns:120px 1fr; padding:12px 0; gap:20px; }
  .roadmap li::before { content:''; position:absolute; left:-24px; top:18px; width:10px; height:10px; border-radius:50%; background:#456957; }
  .story-link { display:inline-block; padding:12px 18px; color:white; background:var(--ink); border-radius:5px; }
  @media(min-width:1000px) {
    .chapter { display:flow-root; }
    .chapter > h3 { float:left; width:37%; margin-right:6%; }
    .chapter > h3 + p { display:flow-root; max-width:none; margin:0 0 24px; }
    .chapter > h3 + p + * { clear:both; }
    .proof { grid-template-columns:repeat(4,minmax(0,1fr)); }
  }
  @media(max-width:420px){.flow-pair{grid-template-columns:1fr;}}
  @media(max-width:900px){.journey ol {grid-template-columns:1fr;} .journey li {padding-left:42px;} .journey li::before {position:absolute;left:0;} .journey li:not(:last-child)::after {content:none;}}
  @media(max-width:760px){.story-opening,.proof,.pairs,.record>div {grid-template-columns:1fr;} .record>div,.roadmap li {gap:5px;} .roadmap li {grid-template-columns:1fr;}  }
</style>
