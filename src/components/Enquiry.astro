---
const {compact=false}=Astro.props;
---
<form class:list={["clean-enquiry-form",{compact}]} id="enquiry-form" method="post">
<input name="_subject" type="hidden" value="Demand Journeys enquiry"/>
<input name="_template" type="hidden" value="table"/>
<input name="page" type="hidden" value="Homepage"/>
<div aria-hidden="true" class="honeypot">
<label for="website">Leave this field empty</label>
<input autocomplete="off" id="website" name="_honey" tabindex="-1" type="text"/>
</div>
<div class="form-row">
<div class="form-field">
<label for="name">Name <span aria-hidden="true" class="required-mark">*</span></label>
<input autocomplete="name" id="name" maxlength="120" name="name" placeholder="Your name" required="" type="text"/>
</div>
<div class="form-field">
<label for="email">Email <span aria-hidden="true" class="required-mark">*</span></label>
<input autocomplete="email" id="email" maxlength="254" name="email" placeholder="you@company.com" required="" type="email"/>
</div>
</div>
<div class="form-field">
<label for="help-with">I need help with <span aria-hidden="true" class="required-mark">*</span></label>
<select id="help-with" name="help_with" required="">
<option disabled="" selected="" value="">Select an option</option>
<option value="AEO/GEO">AEO/GEO</option>
<option value="Hotel Direct Booking">Hotel Direct Booking &amp; OTA Distribution</option>
<option value="Booking Funnel">Booking Funnel &amp; Conversion</option>
<option value="Performance Governance">Performance Marketing &amp; Agency Governance</option>
<option value="MarTech Evaluation">MarTech / CRM Platform Evaluation</option>
<option value="Digital Vouchers">Digital Vouchers &amp; Ancillary GTM</option>
<option value="Growth Marketing">Growth Marketing</option>
<option value="Platforms &amp; Analytics">Platforms &amp; Analytics</option>
<option value="Workshop">Workshop</option>
<option value="Audit">Audit</option>
<option value="Fractional CMO">Fractional CMO</option>
<option value="Hospitality / Travel">Hospitality / Travel</option>
<option value="Marketing / Commercial">Marketing / Commercial</option>
<option value="MarTech / AI">MarTech / AI</option>
<option value="Other">Other</option>
</select>
</div>
<div class="form-field">
<label for="issue">What's the issue? <span aria-hidden="true" class="required-mark">*</span></label>
<textarea id="issue" maxlength="5000" name="issue" placeholder="Briefly describe the issue." required="" rows={compact ? 2 : 4}></textarea>
</div>
<div class="form-action">
<button class="button submit-btn" type="submit">
        Send Enquiry
       </button>
</div>
<div class="form-disclaimer">
{compact ? <p>Used only to respond to your enquiry. <a class="disclaimer-link" href="/privacy/">Privacy</a></p> : <p>Please do not include confidential, commercially sensitive or personal information in your enquiry. Information submitted will only be used to respond to your enquiry. <a class="disclaimer-link" href="/privacy/">Privacy Policy</a></p>}
</div>
<p aria-live="polite" class="form-status" hidden="" id="form-status" role="status"></p>
<noscript>
<p class="no-script-note">
        Please email <a href="mailto:ml@demandjourneys.com">ml@demandjourneys.com</a> directly to send your enquiry.
       </p>
</noscript>
</form>