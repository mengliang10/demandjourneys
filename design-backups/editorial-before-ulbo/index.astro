---
import Enquiry from '../components/Enquiry.astro';
import '../styles/home.css';
const services = [
 { n:'01', type:'Workshop', verb:'Understand.', text:'Clarify the problem and where to focus.' },
 { n:'02', type:'Audit', verb:'Diagnose.', text:'Find what is working, broken or missing.' },
 { n:'03', type:'Fractional CMO', verb:'Lead.', text:'Provide senior marketing leadership through the change.' }
];
const title='Digital marketing. Commercial sense. | Demand Journeys';
const description='Independent digital marketing advice and leadership from Meng Liang Tan. Workshops, audits and fractional CMO support to help your business make demand more profitable.';
---
<!doctype html>
<html lang="en-SG">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f3f0e8" />
  <link rel="canonical" href="https://www.demandjourneys.com/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://www.demandjourneys.com/" />
  <meta property="og:site_name" content="Demand Journeys" />
  <meta property="og:image" content="https://www.demandjourneys.com/splash.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'ProfessionalService',name:'Demand Journeys',url:'https://www.demandjourneys.com/',email:'ml@demandjourneys.com',description,founder:{'@type':'Person',name:'Meng Liang Tan',sameAs:'https://www.linkedin.com/in/mengliang/'}})} />
  <script is:inline defer src="/site.js"></script>
 </head>
 <body data-page="home">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
   <a class="logo" href="/" aria-label="Demand Journeys home"><img src="/identity/demandjourneys-logo-forest.png" alt="Demand Journeys" width="228" height="40" /></a>
   <button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false">Menu</button>
   <nav id="main-navigation" aria-label="Main navigation">
    <a href="/profile/">Profile</a>
    <a href="/hospitality-presentations/">Presentations</a>
    <a href="/methodology/">Methodology</a>
    <a href="https://demandjourneys.substack.com" target="_blank" rel="noopener noreferrer">Substack ↗</a>
    <a href="https://github.com/mengliang10" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
   </nav>
   <a class="header-cta" href="#enquiry">Enquire <span aria-hidden="true">↗</span></a>
  </header>
  <main id="main">
   <section class="hero" aria-labelledby="hero-title" id="top">
    <div class="hero-topline"><p>Independent advice. Experienced leadership.</p><span>Singapore · Asia Pacific</span></div>
    <h1 id="hero-title">Digital marketing.<br /><span>Commercial sense.</span></h1>
    <div class="hero-bottom">
     <p class="hero-intro">I’m Meng Liang Tan. I help businesses connect marketing, technology and customer experience to <strong>make demand more profitable.</strong></p>
     <a class="primary-cta" href="#enquiry">Enquire <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-caption"><span>Two decades across hospitality, travel &amp; digital commerce.</span><a href="/profile/">Meet Meng Liang <span aria-hidden="true">→</span></a></div>
   </section>
   <section class="services" aria-labelledby="services-title" id="ways-to-help">
    <div class="section-heading"><span class="eyebrow">01 / How I can help</span><h2 id="services-title">A clearer way forward.</h2></div>
    <div class="service-grid">{services.map(s=><a class="service" href="#enquiry" data-enquiry={s.type} aria-label={`Enquire about ${s.type}`}><div class="service-top"><span>{s.n}</span><span>{s.type}</span><span aria-hidden="true">↗</span></div><h3>{s.verb}</h3><p>{s.text}</p></a>)}</div>
    <div class="reading-line"><span>Explore the thinking behind the work.</span><div><a href="/methodology/">Methodology →</a><a href="/hospitality-presentations/">Presentations →</a><a href="https://demandjourneys.substack.com" target="_blank" rel="noopener noreferrer">Writing ↗</a></div></div>
   </section>
   <section class="contact" id="enquiry" aria-labelledby="contact-title">
    <div class="contact-intro"><span class="eyebrow">02 / Let’s talk</span><h2 id="contact-title">What are you<br />trying to solve?</h2><p>Tell me what’s happening in your business.<br />We can start there.</p><a class="email-link" href="mailto:ml@demandjourneys.com">ml@demandjourneys.com ↗</a></div>
    <Enquiry />
   </section>
  </main>
  <footer class="site-footer"><div><a href="/" class="footer-name">Demand Journeys</a><span>Independent practice. Singapore.</span></div><nav aria-label="Footer navigation"><a href="/profile/">Profile (1-Pager)</a><a href="/tan-meng-liang-professional-introduction.pdf" download>Download profile ↓</a><a href="https://www.linkedin.com/in/mengliang/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="/hospitality-presentations/">Presentations</a><a href="/methodology/">Methodology</a><a href="https://demandjourneys.substack.com" target="_blank" rel="noopener noreferrer">Substack ↗</a><a href="https://github.com/mengliang10" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/privacy/">Privacy Policy</a></nav><p>© 2026 Demand Journeys. All rights reserved.</p></footer>
 </body>
</html>
