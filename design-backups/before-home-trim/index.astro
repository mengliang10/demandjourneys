---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Enquiry from '../components/Enquiry.astro';
import '../styles/home.css';
import '../styles/final-home.css';
const title='Demand Journeys | Marketing, Search & Growth';
const description='Independent marketing advice and leadership. AEO/GEO, growth marketing, platforms and analytics with Meng Liang Tan.';
const services=[
 {n:'01',title:'AEO/GEO',text:'Make your expertise easier to find, understand and cite.',href:'/ai-search/'},
 {n:'02',title:'Growth Marketing',text:'Connect acquisition, conversion and retention to commercial value.',href:'/services/growth-marketing/'},
 {n:'03',title:'Platforms & Analytics',text:'Connect customer data, technology and measurement to better decisions.',href:'/services/platforms-analytics/'}
];
---
<!doctype html><html lang="en-SG">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#253b34" />
  <link rel="canonical" href="https://www.demandjourneys.com/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" as="image" href="/splash.jpg" media="(min-width: 761px)" />
  <link rel="preload" as="image" href="/splash-mobile.jpg" media="(max-width: 760px)" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://www.demandjourneys.com/" />
  <meta property="og:site_name" content="Demand Journeys" />
  <meta property="og:image" content="https://www.demandjourneys.com/splash.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'ProfessionalService',name:'Demand Journeys',url:'https://www.demandjourneys.com/',email:'ml@demandjourneys.com',description,areaServed:['Singapore','Asia Pacific'],knowsAbout:['Hospitality marketing','Digital marketing','Distribution strategy','Marketing technology','AI search optimisation'],founder:{'@type':'Person',name:'Meng Liang Tan',sameAs:'https://www.linkedin.com/in/mengliang/'}})} />
  <script is:inline defer src="/site.js"></script>
 </head>

<body data-page="home" class="final-home">
<a class="skip-link" href="#main">Skip to content</a><Header home />
<main id="main">
<section class="hero" id="top" aria-labelledby="hero-title">
 <div class="hero-copy"><span class="eyebrow">Meng Liang Tan · Independent advisor</span><h1 id="hero-title">Make demand<br/>more profitable.</h1><p class="hero-intro">Search. Growth. Technology.<br/>Marketing with a commercial perspective.</p><a class="primary-cta" href="#enquiry">Let’s talk <span aria-hidden="true">↗</span></a></div>
 <div class="hero-enquiry" id="enquiry"><h2>What are you trying to solve?</h2><Enquiry compact /></div>
</section>
<section class="services" id="ways-to-help" aria-labelledby="services-title">
 <div class="section-heading"><span class="eyebrow">How I can help</span><h2 id="services-title">Three connected disciplines.</h2></div>
 <div class="service-grid">{services.map(s=><a class="service" href={s.href}><div class="service-top"><span>{s.n}</span><span aria-hidden="true">↗</span></div><h3>{s.title}</h3><p>{s.text}</p><span class="service-read">Explore the service →</span></a>)}</div>
 <div class="engagement-line"><span>Work together through</span><a href="#enquiry" data-enquiry="Workshop">Workshops</a><a href="#enquiry" data-enquiry="Audit">Audits</a><a href="#enquiry" data-enquiry="Fractional CMO">Fractional leadership</a></div>
</section>
<section class="practice-strip" aria-label="About the practice"><img src="/profile.jpg" width="120" height="120" alt="Meng Liang Tan" loading="lazy"/><div><span class="eyebrow">The practice</span><h2>Experience across the whole journey.</h2><p>Two decades across hospitality, travel, digital commerce and marketing technology in Asia Pacific.</p></div><a href="/profile/">Meet Meng Liang →</a></section>
<section class="library-strip" aria-labelledby="library-title"><div><span class="eyebrow">Ideas into practice</span><h2 id="library-title">Explore the thinking.</h2><p>Presentations, commercial frameworks and interactive tools.</p></div><a href="/hospitality-presentations/">Browse presentations →</a></section>
</main><Footer /></body></html>
